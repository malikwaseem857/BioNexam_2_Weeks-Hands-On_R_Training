y = Mean_Age,
fill = Disease)) +
geom_col(width = 0.65, alpha = 0.9, color = "grey30") +
geom_errorbar(
aes(ymin = Mean_Age - SE,
ymax = Mean_Age + SE),
width = 0.2, color = "black", linewidth = 0.7
) +
coord_flip() +
labs(
title    = "Mean Patient Age by Disease Category",
subtitle = "Lahore Laboratory Dataset — Mean ± Standard Error (N = 12,009)",
caption  = "Source: laboratory__data.csv | Error bars represent ±1 SE",
x        = NULL,
y        = "Mean Age (Years)",
fill     = "Disease"
) +
theme_minimal(base_size = 13) +
theme(
plot.title      = element_text(face = "bold", size = 15),
plot.subtitle   = element_text(color = "grey40", size = 11),
plot.caption    = element_text(color = "grey50", size = 9, hjust = 1),
legend.position = "none",
panel.grid.major.y = element_blank(),
panel.grid.minor   = element_blank()
)
